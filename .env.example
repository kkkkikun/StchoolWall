# Local development only. Copy to backend/.env and adjust to docker-compose.yml.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://eywall:eywall123@localhost:5432/ey_wall
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=local-development-only-change-before-deployment
JWT_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DEV_LOGIN_ENABLED=false
PUBLISHING_ENABLED=true
MODERATION_FAIL_OPEN=false
STORAGE_PROVIDER=local
STATIC_BASE_DIR=static
PRIVATE_MEDIA_DIR=private-media
ADMIN_TOKEN_EXPIRE_HOURS=1
ADMIN_MFA_ENCRYPTION_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
TENCENT_BIZ_TYPE=
STUDENT_VERIFICATION_ENABLED=false
VERIFICATION_SCHOOL_ID=pilot
VERIFICATION_SCHOOL_NAME=本校
VERIFICATION_STORAGE_PROVIDER=local
VERIFICATION_PRIVATE_DIR=private-verifications
VERIFICATION_FINGERPRINT_KEY=
VERIFICATION_FINGERPRINT_KEY_VERSION=v1
VERIFICATION_FINGERPRINT_PREVIOUS_KEYS={}
# 内部测试反馈通道
FEEDBACK_TEST_CODE=
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_KIND=generic
FEEDBACK_WEBHOOK_SECRET=
FEEDBACK_ADMIN_BASE_URL=
FEEDBACK_PRIVATE_DIR=private-feedback
# Explicit disposable targets; pytest refuses missing values or a non-*_test DB.
TEST_DATABASE_URL=postgresql+asyncpg://eywall:eywall123@localhost:5432/ey_wall_test
TEST_REDIS_URL=redis://localhost:6379/15
