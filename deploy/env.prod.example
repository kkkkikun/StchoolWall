# ===== SchoolWall 生产环境配置模板 =====
# 复制为 deploy/.env.prod 后填写；此文件绝不提交仓库。

# 环境标识（安全闸门：production 下密钥不合格拒绝启动）
ENVIRONMENT=production

# JWT 密钥（必改！生成：openssl rand -hex 32；≥32 字符，占位符会拒绝启动）
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# 数据库/Redis（compose 里经 host.docker.internal 覆盖连接串，此处密码必须设置）
DB_USER=eywall
DB_PASSWORD=CHANGE_ME_strong_db_password

# CORS 白名单（逗号分隔；填你的域名）
CORS_ORIGINS=https://your-domain.example.com

# 微信小程序（暂无就留空——留空时微信登录不可用，网页登录不受影响）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 公众号网页授权（H5 经公众号入口的微信登录；填公众号的 AppID/AppSecret）
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=

# 教务认证（可选；不配则 /auth/verify 返回 400 提示未配置）
ZHENGFANG_BASE_URL=

# 上传目录（容器内路径，compose 已挂卷，勿改）
# STATIC_BASE_DIR=/data/static

# 以下保持默认即可：
# MODERATION_FAIL_OPEN=False（微信故障时帖子保持待审，合规优先）
# DEV_LOGIN_ENABLED 不设置（生产绝不开 dev-login）
