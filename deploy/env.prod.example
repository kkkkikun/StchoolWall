# Copy to /opt/schoolwall/shared/.env with mode 0600. Never commit real secrets.
# Production is blocked until G0..G4 evidence and matching release-gates.json exist.
ENVIRONMENT=production
DEPLOY_ENVIRONMENT=production
API_PORT=8000
# Choose a subnet that does not overlap host/VPN/container networks before first deploy.
SCHOOLWALL_SUBNET=172.30.0.0/24
SCHOOLWALL_GATEWAY=172.30.0.1
# Compose injects FORWARDED_ALLOW_IPS as the exact gateway above; "*" is prohibited.
JWT_SECRET=CHANGE_ME_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=30
DB_USER=eywall
DB_PASSWORD=CHANGE_ME_URL_SAFE_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_URL_SAFE_RANDOM_REDIS_PASSWORD
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=10000
CORS_ORIGINS=https://REPLACE_DOMAIN
MODERATION_FAIL_OPEN=false
DEV_LOGIN_ENABLED=false
# Hard upper bound: false keeps new submissions closed even if Redis runtime control says enabled.
PUBLISHING_ENABLED=false
ADMIN_TOKEN_EXPIRE_HOURS=1
ADMIN_MFA_ENCRYPTION_KEY=CHANGE_ME_INDEPENDENT_FERNET_KEY

# Real app registration/review required. Blank credentials do not constitute a launch.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=

# Media is private/quarantined until moderation passes.
STORAGE_PROVIDER=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_ENDPOINT=
COS_PUBLIC_BASE_URL=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
TENCENT_BIZ_TYPE=
MEDIA_MAX_PIXELS=25000000
MEDIA_MAX_BYTES=10485760
STATIC_BASE_DIR=/data/static
PRIVATE_MEDIA_DIR=/data/private-media

# Remains closed until private bucket, explicit consent, manual review and deletion drill pass.
STUDENT_VERIFICATION_ENABLED=false
VERIFICATION_SCHOOL_ID=REPLACE_SINGLE_SCHOOL_ID
VERIFICATION_SCHOOL_NAME=REPLACE_SCHOOL_NAME
VERIFICATION_STORAGE_PROVIDER=cos
VERIFICATION_COS_BUCKET=
VERIFICATION_PRIVATE_DIR=/data/private-verifications
VERIFICATION_FINGERPRINT_KEY=CHANGE_ME_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
VERIFICATION_FINGERPRINT_KEY_VERSION=v1
VERIFICATION_FINGERPRINT_PREVIOUS_KEYS={}

# Enable only after the separate pgBackRest overlay/image/archive/restore drill has passed.
# BACKUP_POSTGRES_IMAGE=registry.example/private/postgres-pgbackrest@sha256:...
# BACKEND_IMAGE / BUILD_REVISION are injected from the verified immutable release manifest.
