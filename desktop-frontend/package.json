{
  "name": "schoolwall-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --noEmit",
    "build:desktop": "vite build --base=/pc/ && vue-tsc --noEmit",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "generate:api": "node scripts/generate-api.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.5",
    "vue-tsc": "~3.1.8"
  },
  "overrides": {
    "follow-redirects": "^1.16.2"
  }
}
